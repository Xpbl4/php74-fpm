# PHP 7.4 FPM on Alpine: the PHP modules, paths and startup of the Ubuntu image (Dockerfile),
# with the ImageMagick tools, without ffmpeg, pdftk, ghostscript, python and locales-all.
FROM php:7.4-fpm-alpine3.16

COPY --from=mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/

# The same PHP modules as the Ubuntu image (the rest are built into the official image);
# bash and GNU sed run the shared startup script, cronie reads /etc/cron.d like Debian cron,
# imagemagick brings the convert/magick tools next to the imagick module.
# Then the Ubuntu paths that projects rely on: binaries, conf.d mounts, the FPM pool directory
# and www-data with uid/gid 33, which owns the projects' state files.
RUN install-php-extensions \
        apcu \
        apcu_bc \
        calendar \
        exif \
        ffi \
        gd \
        gettext \
        imagick \
        intl \
        memcache \
        mysqli \
        opcache \
        pcntl \
        pdo_mysql \
        shmop \
        sockets \
        sysvmsg \
        sysvsem \
        sysvshm \
        xsl \
        zip \
    && rm /usr/local/bin/install-php-extensions \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && apk add --no-cache bash cronie imagemagick sed tzdata \
    && mkdir -p /etc/php/7.4/fpm/conf.d /etc/php/7.4/cli/conf.d /etc/php/7.4/fpm/pool.d \
    && ln -s /usr/sbin/crond /usr/sbin/cron \
    && ln -s /usr/local/bin/php /usr/bin/php \
    && ln -s /usr/local/bin/php /usr/bin/php7.4 \
    && printf 'include=/etc/php/7.4/fpm/pool.d/*.conf\n' >> /usr/local/etc/php-fpm.conf \
    && deluser www-data \
    && (delgroup www-data 2>/dev/null || true) \
    && user=$(awk -F: '$3 == 33 {print $1}' /etc/passwd) && { [ -z "$user" ] || deluser "$user"; } \
    && group=$(awk -F: '$3 == 33 {print $1}' /etc/group) && { [ -z "$group" ] || delgroup "$group"; } \
    && addgroup -g 33 -S www-data \
    && adduser -u 33 -S -D -H -h /var/www -s /sbin/nologin -G www-data www-data \
    && chown -R www-data:www-data /var/www

ENV PHP_INI_SCAN_DIR=:/etc/php/7.4/cli/conf.d

COPY php-fpm7.4-alpine /usr/sbin/php-fpm7.4
COPY overrides.conf /etc/php/7.4/fpm/pool.d/z-overrides.conf
COPY php-fpm-startup /usr/bin/php-fpm

CMD ["/usr/bin/php-fpm"]

EXPOSE 9000
